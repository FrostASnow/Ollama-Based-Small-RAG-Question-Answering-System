# ============================================================================
#  离线 RAG 文档问答 —— 配置示例
#  用法：复制为项目根目录下的 .env，按需修改；所有变量都是可选的。
#  注意：换嵌入模型（RAG_EMBEDDING_MODEL_NAME）后必须重建索引，向量空间不通用。
# ============================================================================

# ---------------------------- 服务 ----------------------------
RAG_HOST=127.0.0.1
RAG_PORT=8000

# 服务就绪后自动打开这个地址（留空 = 不打开）。start.ps1 会设成实际访问地址，
# 只有服务真的返回 200 了才开浏览器。
# RAG_OPEN_BROWSER_URL=http://127.0.0.1:8000
# 置 0 则只记录地址、不打开浏览器（等价于 start.ps1 -NoBrowser）
# RAG_AUTO_OPEN_BROWSER=1

# ---------------------------- LLM (Ollama) ----------------------------
# 推理模型。deepseek-r1:1.5b 体积最小且带推理链；可换 llama3.2（约 2GB）或 qwen2.5:3b。
# 切换后请确保已执行：ollama pull <模型名>
RAG_LLM_MODEL=deepseek-r1:1.5b
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434

# 温度：文档问答建议低一些，减少发挥
RAG_LLM_TEMPERATURE=0.1
# 上下文窗口与单次最大生成 token 数。中文约「1 字 ≈ 1 token」，
# 窗口太小而资料太长时 Ollama 会静默截断提示词，表现为丢指令甚至空回答。
RAG_LLM_NUM_CTX=8192
RAG_LLM_NUM_PREDICT=2048
# 重复惩罚：1.5B 容易陷进「同一句话连写四遍」，这是代价最小的缓解手段
RAG_LLM_REPEAT_PENALTY=1.2
RAG_LLM_REPEAT_LAST_N=512
# 是否把 deepseek-r1 的推理过程推送到前端（前端可折叠展示）
RAG_EXPOSE_THINKING=true
# 启动后是否在后台把 LLM 预载入显存。Ollama 是懒加载的，不预热则第一条提问要等模型载入。
RAG_WARMUP_LLM=true

# ---------------------------- 嵌入模型 ----------------------------
# 默认：英文为主，体积小（约 90MB），384 维
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# 中文知识库推荐（需重新下载模型并重建索引）：
#   RAG_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
#   RAG_EMBEDDING_DIMENSION=512
# 多语言场景推荐：
#   RAG_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   RAG_EMBEDDING_DIMENSION=384

# 模型尺寸（all-MiniLM-L6-v2=384，bge-small-zh-v1.5=512）
RAG_EMBEDDING_DIMENSION=384

# 运行设备：cpu / cuda。4GB 显存以下建议 cpu
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=32

# 留空则自动使用 models/<模型名末段>
# RAG_EMBEDDING_LOCAL_DIR=

# ---------------------------- 切分 ----------------------------
# 单个分块的目标字符数。文档结构复杂可调小，叙述性长文可调大。
RAG_CHUNK_SIZE=800
# 相邻分块重叠字符数，避免答案正好被切断
RAG_CHUNK_OVERLAP=120
# PDF 解析时删除在多页重复出现的短行（页眉/页脚/刊头），否则会挤掉正文的召回槽位。
RAG_STRIP_BOILERPLATE=true
# PDF 解析时按版面补回段落边界（小节标题、中英文切换处另起一段），否则只能按字符数硬切。
RAG_RESTORE_PDF_PARAGRAPHS=true
# 截掉文末「参考文献 / References」列表：关键词密集、语义贫乏，却常居相似度第一。
RAG_STRIP_REFERENCES=true
# 多页 PDF 平均每页字符数低于此值判定为「疑似扫描件 / 图片版」，并给出警告。
RAG_PDF_MIN_CHARS_PER_PAGE=120
# 以上解析开关只影响新入库的文档。改完请点「重建索引」或调 POST /api/documents/reindex；
# 改 chunk_size / chunk_overlap 同理。换嵌入模型后必须重建，否则检索会被直接拒绝。

# ---------------------------- 检索 ----------------------------
# 送入 LLM 的片段数。调大召回更全但更慢、更容易超出上下文。
RAG_TOP_K=4
# 余弦相似度下限。默认刻意设得很低：小模型处理中文时分数区分度弱，阈值高会误杀相关片段。
RAG_SCORE_THRESHOLD=0.20
# 相对窗口：只保留与最佳片段相差不超过该值的候选。设 0 关闭，退回纯绝对阈值。
RAG_SCORE_WINDOW=0.12
# 兜底下限：阈值内一条都没命中时，最多放宽到这个分数；设 -1 表示不限。
RAG_SCORE_FLOOR=0.10
# 只在这个阈值以内才允许自动放宽，用户把阈值调得更严格时不擅自替他放宽。
RAG_SCORE_RELAX_LIMIT=0.35
# 近重复片段（例如同一段页眉被切进多个 chunk）只保留分数最高的一个
RAG_DEDUPE_RATIO=0.80
# 拼进提示词的参考资料最大字符数，防止超出 num_ctx（实际预算为该值与 num_ctx 反推上限的较小者）。
RAG_MAX_CONTEXT_CHARS=6000

# ---------------------------- 概览（总结类问题）----------------------------
# 「总结 / 概述 / 讲了什么」问的是整篇，与任何单个片段都不相似，靠阈值筛必然漏；
# 这类提问改为按全篇均匀取样，下面是取样块数上限。
RAG_SUMMARY_MAX_CHUNKS=10

# ---------------------------- 上传 ----------------------------
RAG_MAX_UPLOAD_MB=50

# ---------------------------- 生成 ----------------------------
# 送入 LLM 的历史轮数（1 轮 = 一问一答）
RAG_MAX_HISTORY_TURNS=6

# ---------------------------- 索引维护 ----------------------------
# 重建索引前先把当前索引备份到 data/index/backups/<时间戳>/；还原时把其中的
# .faiss / .pkl 拷回 data/index/ 即可。
RAG_BACKUP_BEFORE_REINDEX=true
# 备份保留份数（一份索引通常只有几百 KB）
RAG_INDEX_BACKUP_KEEP=3
