# ============================================================================
#  离线 RAG 文档问答 —— 配置示例
#
#  用法：把本文件复制为项目根目录下的 .env，按需修改。
#        所有变量都是可选的，不配置时使用下面的默认值。
#
#  注意：修改嵌入模型（RAG_EMBEDDING_MODEL_NAME）后必须重建索引，
#        因为不同模型的向量空间不通用。
# ============================================================================

# ---------------------------- 服务 ----------------------------
RAG_HOST=127.0.0.1
RAG_PORT=8000

# 服务就绪后自动打开这个地址（留空 = 不打开）。
# scripts\start.ps1 会把它设成实际访问地址，从而保证「先弹出连接被拒绝的错误页」
# 这种情况不再出现：只有服务真的能返回 200 了，浏览器才会被打开。
# RAG_OPEN_BROWSER_URL=http://127.0.0.1:8000
# 置 0 则只记录地址、不真的打开浏览器（等价于 start.ps1 -NoBrowser）
# RAG_AUTO_OPEN_BROWSER=1

# ---------------------------- LLM (Ollama) ----------------------------
# 推理模型。deepseek-r1:1.5b 体积最小且带推理链；
# 想让回答质量更好可以换 llama3.2（约 2GB）或 qwen2.5:3b。
# 切换后请确保已执行：ollama pull <模型名>
RAG_LLM_MODEL=deepseek-r1:1.5b
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434

# 温度：文档问答建议低一些，减少发挥
RAG_LLM_TEMPERATURE=0.1
# 上下文窗口与单次最大生成 token 数。
# 中文约「1 字 ≈ 1 token」：窗口太小而资料太长时，Ollama 会静默截断提示词，
# 表现是模型丢掉指令、甚至返回空回答（真机复验时遇到过）。
# 概览类问题要塞进整篇文档的取样片段（默认预算 6000 字 ≈ 3500 token），
# 所以窗口给 8192，生成上限给 2048。
RAG_LLM_NUM_CTX=8192
RAG_LLM_NUM_PREDICT=2048
# 重复惩罚：1.5B 模型很容易陷进「同一句话连写四遍」的退化，这是代价最小的缓解手段
RAG_LLM_REPEAT_PENALTY=1.2
RAG_LLM_REPEAT_LAST_N=512
# 是否把 deepseek-r1 的推理过程推送到前端（前端可折叠展示）
RAG_EXPOSE_THINKING=true
# 启动后是否在后台把 LLM 预载入显存。
# Ollama 是懒加载的：不预热的话，用户的第一条提问要等模型载入（本机实测
# 冷启动约 100 秒，之后同一模型只要 0.4 秒）。
RAG_WARMUP_LLM=true

# ---------------------------- 嵌入模型 ----------------------------
# 默认：英文为主，体积小（约 90MB），384 维
RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# 中文知识库推荐（需重新下载模型并重建索引）：
#   RAG_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
#   RAG_EMBEDDING_DIMENSION=512
# 多语言场景推荐：
#   RAG_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   RAG_EMBEDDING_DIMENSION=384

# 模型尺寸（all-MiniLM-L6-v2=384，bge-small-zh-v1.5=512）
RAG_EMBEDDING_DIMENSION=384

# 运行设备：cpu / cuda。4GB 显存以下建议 cpu（嵌入模型很小，CPU 已经很快）
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=32

# 留空则自动使用 models/<模型名末段>
# RAG_EMBEDDING_LOCAL_DIR=

# ---------------------------- 切分 ----------------------------
# 单个分块的目标字符数。文档结构复杂可调小，叙述性长文可调大。
RAG_CHUNK_SIZE=800
# 相邻分块重叠字符数，避免答案正好被切断
RAG_CHUNK_OVERLAP=120
# PDF 解析时删除在多页重复出现的短行（页眉/页脚/刊头）。
# 期刊页眉是「关键词拼盘」，对任何提问相似度都高，会挤掉正文的召回槽位。
RAG_STRIP_BOILERPLATE=true
# PDF 解析时按版面补回段落边界（小节标题、中英文切换处另起一段）。
# PDF 抽出来是硬换行，不补的话切分器只能按字符数硬切，
# 中文正文会和英文摘要粘进同一个块（实测相似度 0.367 → 0.147）。
RAG_RESTORE_PDF_PARAGRAPHS=true
# 截掉文末「参考文献 / References」列表：关键词密集、语义贫乏，
# 实测对「总结这篇文档的主要内容」稳居相似度第一，却提供不了可用信息。
RAG_STRIP_REFERENCES=true
# 注意：以上三个解析开关只影响新入库的文档。改完请点界面上的
#      「重建索引」，或调 POST /api/documents/reindex 让旧文档重新分块。

# ---------------------------- 检索 ----------------------------
# 送入 LLM 的片段数。调大召回更全但更慢、更容易超出上下文。
RAG_TOP_K=4
# 余弦相似度下限。默认刻意设得很低：
# 小模型（尤其 all-MiniLM-L6-v2 处理中文时）分数区分度弱，
# 阈值设高会误杀相关片段。宁可靠 LLM 依据上下文判断，也不要漏召回。
RAG_SCORE_THRESHOLD=0.20
# 相对窗口：只保留与最佳片段相差不超过该值的候选。
# all-MiniLM-L6-v2 的分数分布很扁（完全无关的乱码也能到 0.25），
# 单靠绝对阈值区分不了「都相关」和「一片噪声」。设 0 关闭，退回纯绝对阈值。
RAG_SCORE_WINDOW=0.12
# 兜底下限：阈值内一条都没命中时，最多放宽到这个分数；设 -1 表示不限。
RAG_SCORE_FLOOR=0.10
# 只在这个阈值以内才允许自动放宽。用户把阈值调得更严格（例如 0.5）时，
# 说明他要的就是高精度，程序不擅自替他放宽，而是明确回答「没找到」。
RAG_SCORE_RELAX_LIMIT=0.35
# 近重复片段（例如同一段页眉被切进多个 chunk）只保留分数最高的一个
RAG_DEDUPE_RATIO=0.80
# 拼进提示词的参考资料最大字符数，防止超出 num_ctx。
# 注意实际预算是 min(这个值, 由 num_ctx 反推的安全上限)：
# 例如 num_ctx=4096 时预算会被压到约 2260 字，避免提示词被静默截断。
RAG_MAX_CONTEXT_CHARS=6000

# ---------------------------- 概览（总结类问题）----------------------------
# 「总结 / 概述 / 讲了什么」问的是整篇，与任何单个片段都不相似
# （实测「总结一下」最佳相似度 0.273，只比乱码高一点），靠阈值筛必然漏。
# 这类提问改为按全篇均匀取样，下面是取样块数上限。
RAG_SUMMARY_MAX_CHUNKS=10

# ---------------------------- 上传 ----------------------------
RAG_MAX_UPLOAD_MB=50

# ---------------------------- 生成 ----------------------------
# 送入 LLM 的历史轮数（1 轮 = 一问一答）
RAG_MAX_HISTORY_TURNS=6
